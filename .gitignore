# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Model weights (large, auto-downloaded by Ultralytics) ----
models/*.pt
models/*.onnx
models/*.engine
*.pt
*.onnx
*.engine

# ---- Input / uploaded media (large binaries) ----
input
module/input
uploads/

# ---- Generated test artefacts (the test CODE is tracked on purpose) ----
tests/*-out/
tests/**/events.csv

# ---- Central's database (disposable: delete it to apply a schema change) ----
central/*.db
central/*.db-shm
central/*.db-wal

# ---- Generated outputs ----
output
module/output

# ---- Local environment config (commit only the .env.example files) ----
.env
*/.env
!*/.env.example
# ---- Ultralytics / training artifacts ----
runs/
*.cache
# Raw footage and extracted frames: large, and often not ours to redistribute.
training/videos/*
!training/videos/README.txt
training/dataset/

# ---- Logs ----
*.log

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
