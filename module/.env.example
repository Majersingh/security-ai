# Analysis module configuration. Copy to `module/.env` and edit.
#   uvicorn module.app:app --env-file module/.env --host 0.0.0.0 --port 8001
#
# `.env` is gitignored; this example file is what gets committed.
#
# NOTE: this file only configures how the module TALKS TO CENTRAL. Pipeline
# tuning (num_workers, inference_imgsz, frame_stride, batch sizes, hw_decode…)
# lives in `module/core/config.py` and is not read from the environment — edit
# that file per deployment.

# ---- Central app -------------------------------------------------------------
# Where to report. Leave EMPTY to run this module completely standalone: it still
# serves /feeds/* and its own dashboard, it just registers nothing and reports
# nothing. That is a supported mode, not a broken one.
CENTRAL_URL=https://central.yourorg.internal

# Must match CENTRAL_TOKEN on the central app.
MODULE_TOKEN=change-me

# Stable identity for THIS box. If unset a random id is generated at startup,
# which means a restart looks like a brand-new module to central and the old
# record lingers until it is reaped. Set it to something durable per host.
MODULE_ID=gpu-host-1

# How central and OPERATORS' BROWSERS reach this module. Browsers connect here
# directly for annotated video (frames never pass through central), so it must be
# an address they can actually resolve — not 127.0.0.1, and not a docker-internal
# hostname. Include the port you serve on.
MODULE_PUBLIC_URL=http://10.0.1.22:8001

# ---- Raw video service (SEPARATE PROCESS) -------------------------------------
# Smooth source-rate playback, independent of detection. Run it alongside:
#   uvicorn module.rawapp:app --host 0.0.0.0 --port 8011
# Advertise where BROWSERS reach it; blank means this host serves analysed video
# only and the video wall falls back to the detection stream (detection-rate fps).
RAW_PUBLIC_URL=http://10.0.1.22:8011
