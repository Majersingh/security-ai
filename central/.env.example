# Central app configuration. Copy to `central/.env` and edit.
#   uvicorn central.app:app --env-file central/.env --host 0.0.0.0 --port 9000
#
# `.env` is gitignored; this example file is what gets committed.

# ---- Storage -----------------------------------------------------------------
# SQLite file holding modules, cameras and events. Anywhere writable.
# Back this up: it is the camera registry AND the violation history.
CENTRAL_DB=central/central.db

# ---- Module authentication ---------------------------------------------------
# Shared secret every module must send as `X-Module-Token` to register, heartbeat
# or report events. Modules set the same value as MODULE_TOKEN.
# LEAVING THIS EMPTY MEANS ANY HOST CAN REGISTER AS A MODULE — set it.
CENTRAL_TOKEN=change-me

# ---- Capacity planning -------------------------------------------------------
# The frame_stride the modules are running. Central needs it to work out what
# each camera will demand of a module:  demand_fps = source_fps / CENTRAL_STRIDE.
# This MUST match `frame_stride` in module/core/config.py, or placement will
# either overcommit modules or refuse cameras that would have fit.
CENTRAL_STRIDE=1

# Seconds without a heartbeat before a module is treated as offline and its
# cameras are released for re-placement onto a healthy module. Reassignment
# restarts tracking identities, so don't set this so low that a slow network
# blip triggers it.
CENTRAL_STALE_AFTER=30
