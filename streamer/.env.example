# Streamer configuration. Copy to `streamer/.env` and edit.
#   uvicorn streamer.app:app --env-file streamer/.env --host 0.0.0.0 --port 8011
#
# This service registers ITSELF with central, so a video-only host needs nothing
# else running — no detection service, no model, no GPU.

# ---- Central ------------------------------------------------------------------
# Where to register. Blank = streaming still works, but central won't know this
# streamer exists, so cameras show `playable: false`.
CENTRAL_URL=https://central.yourorg.internal
MODULE_TOKEN=change-me                  # must match CENTRAL_TOKEN

# Identifies the MACHINE. Set it to the SAME value as the detection module's HOST_ID
# when both run on one box: central then prefers this co-located streamer, which
# provably has a network route to that host's cameras.
HOST_ID=gpu-host-1

# Where BROWSERS reach this service. Not 127.0.0.1 unless the browser is on this
# machine, and not a docker-internal hostname — the browser connects here directly.
STREAMER_PUBLIC_URL=http://10.0.1.22:8011

# STREAMER_ID=gpu-host-1-streamer       # defaults to <HOST_ID>-streamer

# ---- Tuning (all optional) ----------------------------------------------------
# Each stream is ONE EXTRA DECODE of that camera, so this cap is what stops a video
# wall's "all" button from swamping the host.
STREAMER_MAX_STREAMS=16
STREAMER_MAX_WIDTH=960                  # downscale for the wire
STREAMER_JPEG_QUALITY=55
STREAMER_CV_THREADS=2                   # decode/encode threads; never runs a model
STREAMER_HW_DECODE=true                 # NVDEC, automatic software fallback
STREAMER_DECODE_THREADS=1               # per stream; parallelism comes from streams
STREAMER_MAX_LAG_SECONDS=0.5            # drop stale frames rather than drift behind
LOG_LEVEL=INFO
